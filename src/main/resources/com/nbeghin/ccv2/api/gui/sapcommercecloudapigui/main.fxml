<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="mainWindow" alignment="CENTER" prefHeight="500.0" prefWidth="620.0" spacing="0"
      xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="com.nbeghin.ccv2.api.gui.sapcommercecloudapigui.MainController">

    <MenuBar fx:id="menuBar" VBox.vgrow="NEVER">
        <Menu mnemonicParsing="false" text="File">
            <MenuItem fx:id="menuItemSettings" mnemonicParsing="false" onAction="#onActionMenuSettings" text="Settings"/>
            <MenuItem fx:id="menuItemClearConsole" mnemonicParsing="false" onAction="#onActionMenuClearConsole" text="Clear console"/>
            <MenuItem fx:id="menuItemQuit" mnemonicParsing="false" onAction="#onActionMenuQuit" text="Quit"/>
        </Menu>
        <Menu mnemonicParsing="false" text="Help">
            <MenuItem fx:id="menuItemAbout" mnemonicParsing="false" onAction="#onActionMenuAbout" text="About"/>
        </Menu>
    </MenuBar>
    <AnchorPane VBox.vgrow="ALWAYS" >

        <VBox AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                <Tab text="Existing builds" fx:id="tabExistingBuild">
                    <VBox VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="5.0" left="20.0" right="20.0" top="10.0"/>
                        </padding>
                        <TableView fx:id="tableBuilds" disable="true" prefHeight="250.0" prefWidth="150.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="No builds loaded"/>
                            </placeholder>
                        </TableView>
                        <HBox spacing="5">
                            <padding>
                                <Insets top="5.0"/>
                            </padding>
                            <Button fx:id="btnStartDeploy" alignment="BASELINE_RIGHT" disable="true" onAction="#onStartDeploy" text="Deploy"/>
                        </HBox>
                    </VBox>

                </Tab>
                <Tab text="New build" fx:id="tabNewBuild">
                    <VBox VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="5.0" left="20.0" right="20.0" top="10.0"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <TextField fx:id="txtGitBranches" promptText="Git branch or tag" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtBuildCode" maxWidth="Infinity" minWidth="200" promptText="Build name" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnProposeBuildName" disable="true" onAction="#onSuggestNewBuildName">
                                <tooltip>
                                    <Tooltip text="Suggest build name"/>
                                </tooltip>
                            </Button>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <padding>
                                <Insets top="5.0"/>
                            </padding>
                            <Button fx:id="btnStartBuild" disable="true" onAction="#onStartBuild" text="Build"/>
                            <CheckBox fx:id="checkboxDeployAfterBuild" disable="true" text="Deploy after build"/>
                        </HBox>
                    </VBox>

                </Tab>

                <Tab text="Deployments" fx:id="tabDeployments">
                    <VBox VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="5.0" left="20.0" right="20.0" top="10.0"/>
                        </padding>
                        <TableView fx:id="tableDeployments" disable="true" prefHeight="250.0" prefWidth="150.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="No deployments loaded"/>
                            </placeholder>
                        </TableView>
                        <HBox spacing="5">
                            <padding>
                                <Insets top="5.0"/>
                            </padding>
                        </HBox>
                    </VBox>

                </Tab>

                <Tab text="Endpoints" fx:id="tabEndpoints">
                    <VBox spacing="5" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="5.0" left="20.0" right="20.0" top="10.0"/>
                        </padding>
                        <TableView fx:id="tableEndpoints" disable="true" prefHeight="180.0" prefWidth="150.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="No endpoints loaded"/>
                            </placeholder>
                        </TableView>
                        <VBox spacing="5">
                            <padding>
                                <Insets top="5.0"/>
                            </padding>
                            <HBox alignment="BASELINE_LEFT" spacing="10">
                                <Label text="Start:">
                                    <tooltip><Tooltip text="Maintenance start date and time"/></tooltip>
                                </Label>
                                <DatePicker fx:id="datePickerMaintenanceStart" promptText="Date" disable="true" prefWidth="115"/>
                                <Spinner fx:id="spinnerMaintenanceHour" prefWidth="60" disable="true"/>
                                <Label text=":"/>
                                <Spinner fx:id="spinnerMaintenanceMinute" prefWidth="60" disable="true"/>
                                <Label text="End:">
                                    <tooltip><Tooltip text="Maintenance end date and time"/></tooltip>
                                </Label>
                                <DatePicker fx:id="datePickerMaintenanceEnd" promptText="Date" disable="true" prefWidth="115"/>
                                <Spinner fx:id="spinnerMaintenanceEndHour" prefWidth="60" disable="true"/>
                                <Label text=":"/>
                                <Spinner fx:id="spinnerMaintenanceEndMinute" prefWidth="60" disable="true"/>
                            </HBox>
                            <Button fx:id="btnScheduleMaintenance" disable="true"
                                    onAction="#onScheduleMaintenance" text="Schedule maintenance mode"
                                    maxWidth="Infinity"/>
                        </VBox>
                        <HBox spacing="5">
                        </HBox>
                    </VBox>
                </Tab>
                <Tab text="Scheduled activities" fx:id="tabScheduledActivities">
                    <VBox VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="5.0" left="20.0" right="20.0" top="10.0"/>
                        </padding>
                        <TableView fx:id="tableScheduledActivities" disable="true"
                                   prefHeight="250.0" prefWidth="150.0"
                                   HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="No scheduled activities loaded"/>
                            </placeholder>
                        </TableView>
                        <HBox spacing="5">
                            <padding>
                                <Insets top="5.0"/>
                            </padding>
                            <Button fx:id="btnNewActivity" text="New Activity" onAction="#onNewActivity"/>
                            <Button fx:id="btnCancelActivity" text="Cancel Activity"
                                    onAction="#onCancelActivity" disable="true"/>
                        </HBox>
                    </VBox>
                </Tab>
            </TabPane>

            <TextArea fx:id="txtAreaConsole" maxHeight="90" prefHeight="90" editable="false" wrapText="true"/>

            <HBox spacing="5" alignment="CENTER_LEFT">
                <padding>
                    <Insets bottom="5.0" left="20.0" right="20.0" top="5.0"/>
                </padding>
                <ComboBox fx:id="comboEnvironments" disable="true" promptText="Environment" HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="Target environment"/>
                    </tooltip>
                </ComboBox>
                <ComboBox fx:id="comboDeploymentStrategies" promptText="Deployment strategy" HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="Deployment strategy"/>
                    </tooltip>
                </ComboBox>
                <ComboBox fx:id="comboDeploymentDatabaseUpdateMode" promptText="Database update mode" HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="Database update mode"/>
                    </tooltip>
                </ComboBox>
                <ProgressBar fx:id="mainProgressBar" progress="0" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="btnRefresh" onAction="#onRefresh">
                    <tooltip>
                        <Tooltip text="Refresh"/>
                    </tooltip>
                </Button>
            </HBox>
        </VBox>

    </AnchorPane>
</VBox>
